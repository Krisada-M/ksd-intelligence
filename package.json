{
  "name": "@krisada-m/ksd-intelligence",
  "version": "1.1.0",
  "type": "module",
  "description": "KSD engineering policy plus ei_* code-intelligence tools for OMP",
  "license": "MIT",
  "author": "Krisada M. (https://github.com/Krisada-M)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Krisada-M/ksd-intelligence.git"
  },
  "homepage": "https://github.com/Krisada-M/ksd-intelligence#readme",
  "bugs": {
    "url": "https://github.com/Krisada-M/ksd-intelligence/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist/",
    "scripts/agy-mcp.mjs",
    "scripts/mcp/",
    "skills/",
    "skills.lock.json",
    "skills.registry.json",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-policy-to-dist.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tests/tsconfig.json --noEmit",
    "test": "npm run build && tsc -p tests/tsconfig.json && node scripts/copy-policy-to-dist.mjs --test-tree && node --import ./tests/policy/helpers/isolated-home.js --test dist-test/tests/core/*.test.js dist-test/tests/workflow/*.test.js tests/policy/*.test.js tests/packaging/*.test.js",
    "check:dist": "npm run build && git diff --exit-code dist/ && node scripts/check-dist-untracked.mjs",
    "verify:skills": "node scripts/verify-unified-skills.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "prepare": "husky || true"
  },
  "bin": {
    "ei": "dist/adapters/cli/main.js",
    "ksd-check-changed": "dist/adapters/cli/check-changed.js",
    "ksd-review-verdict": "dist/adapters/cli/review-verdict.js"
  },
  "exports": {
    ".": "./dist/adapters/omp/extension.js",
    "./eslint": "./dist/policy/eslint-rules/index.js"
  },
  "omp": {
    "extensions": [
      "./dist/adapters/omp/extension.js"
    ]
  },
  "pi": {
    "extensions": [
      "./dist/adapters/omp/extension.js"
    ]
  },
  "eiRuntime": {
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "prettier": "^3.10.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "8.72.1"
  }
}
